{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngineeringTask v1",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "agent",
    "objective"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "enum": [
        "bc_agent",
        "data_agent"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
